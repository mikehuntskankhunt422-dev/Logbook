{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logbook",
  "version": "0.1.0",
  "identifier": "app.logbookjournal.desktop",
  "build": {
    "devUrl": "http://localhost:5174",
    "frontendDist": "../../web/dist-desktop",
    "beforeDevCommand": {
      "script": "npm run dev:desktop",
      "cwd": "../../web",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:desktop",
      "cwd": "../../web"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Logbook",
        "width": 1200,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Lifestyle",
    "publisher": "Logbook",
    "shortDescription": "A private multimedia journal you can print as a book",
    "longDescription": "Logbook keeps your journal as files in a folder on your computer, with photos, video and voice notes, and turns it into a printed book when you want one.",
    "copyright": "© 2026 Logbook",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "section": "misc"
      },
      "rpm": {
        "release": "1"
      }
    }
  }
}
