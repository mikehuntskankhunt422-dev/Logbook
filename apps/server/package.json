{
  "name": "@logbook/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-transform-types --no-warnings --watch src/main.ts --local-storage",
    "start": "node --experimental-transform-types --no-warnings src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "samples": "node --experimental-transform-types --no-warnings scripts/make-samples.ts",
    "test:print": "vitest run --config vitest.golden.config.ts",
    "lulu:packages": "node --experimental-transform-types --no-warnings scripts/verify-lulu-packages.ts",
    "lulu:validate": "node --experimental-transform-types --no-warnings scripts/validate-samples.ts",
    "samples:pack": "node --experimental-transform-types --no-warnings scripts/pack-samples.ts",
    "pricing:table": "node --experimental-transform-types --no-warnings scripts/pricing-table.ts"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-emoji": "5.3.2",
    "@logbook/core": "0.1.0",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.5",
    "pagedjs": "0.4.3",
    "pdf-lib": "^1.17.1",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
