{
  "name": "logbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @logbook/web",
    "build": "npm run build -w @logbook/web",
    "preview": "npm run preview -w @logbook/web",
    "desktop": "npm run dev -w @logbook/desktop",
    "desktop:build": "npm run build -w @logbook/desktop",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run test:e2e -w @logbook/web",
    "test:print": "npm run test:print -w @logbook/server",
    "samples": "npm run samples -w @logbook/server --",
    "lulu:packages": "npm run lulu:packages -w @logbook/server --",
    "lulu:validate": "npm run lulu:validate -w @logbook/server --",
    "lhci": "npx --yes @lhci/cli@0.15.x autorun --config=apps/web/lighthouserc.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
